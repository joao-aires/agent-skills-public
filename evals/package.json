{
  "name": "agent-skills-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic promptfoo suite for the agent-skills collection",
  "scripts": {
    "eval:case": "node scripts/run.mjs case",
    "eval:pr": "node scripts/run.mjs pr",
    "eval:ci": "node scripts/run.mjs ci",
    "eval:nightly": "node scripts/run.mjs nightly",
    "eval:full": "node scripts/run.mjs full",
