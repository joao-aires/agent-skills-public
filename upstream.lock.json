    {
      "plugin": "development-workflow",
      "repository": "https://github.com/mattpocock/skills.git",
      "commit": "4588b32ecab9ecc9fc8cc6b6c5e7d675b6004b0d",
      "path": "skills/engineering/implement-spec",
      "tree": "0cfefc751d0cb64f0c948ffcb17e13b94e778f08",
      "license": "MIT",
      "license_path": "LICENSE",
      "adaptations": [
        "workflow-framing",
        "documentation-paths",
        "tickets-optional"
      ],
      "replacements": [
        {
          "from": "description: \"Implement the result of /to-spec and /to-tickets in code.\"",
          "to": "description: \"Implement an agreed spec, conversation or Markdown plan; tickets are optional.\""
        },
        {
          "from": "You have been provided a spec. This spec should have tickets associated with it, describing how to implement the spec.\n\nThe issue tracker should have been provided to you. If not, tell the user to run `/setup-matt-pocock-skills`.\n\nThe goal is the entire spec implemented on a single **integration branch**, with every ticket resolved the way the issue tracker closes work.\n\nThe tickets are not a list of steps. They are a **task graph** with blocking relationships between them. This means there is always a **frontier** of tickets which are ready to be grabbed.\n\n",
          "to": "Use the agreed conversation, a Markdown spec or an existing plan as the implementation scope. Tickets and issue-tracker setup are optional, used only when explicitly requested or already supplied for this work.\n\nImplement the scope on one integration branch. Derive a small internal work plan from the requirements and dependencies; no ticket files, issue IDs, labels or tracker are required. Parallelize independent work only when the client supports it.\n\n"
        },
        {
          "from": "Read the spec and tickets to understand the task graph.",
          "to": "Read the agreed scope and derive the work dependencies. Use existing tickets only if the user chose that workflow."
        },
        {
          "from": "Create the integration branch. If the issue tracker closes work through PRs, or the user asks for one, open a draft PR after the first merge in step 5 (a branch with no commits ahead of main can't open one), marked as closing the spec and tickets.",
          "to": "Create the integration branch. If the user asks for a PR, open a draft after the first implementation commit or merge. Reference the agreed scope; add issue-closing references only when explicitly tracking issues."
        },
        {
          "from": "Otherwise, resolve each ticket the way the issue tracker closes work, and report the integration branch.",
          "to": "Report the integration branch and completed requirements. Resolve tracked issues only when that workflow was explicitly requested."
        },
        {
          "from": "tickets",
          "to": "work items"
        },
        {
          "from": "ticket",
          "to": "work item"
        }
      ]
    },
